{
  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": true
  },
  "fmt": {
    "options": {
      "indentWidth": 2,
      "lineWidth": 80,
      "singleQuote": true,
      "proseWrap": "preserve"
    }
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any"]
    }
  },
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env supabase/functions/whatsapp-webhook/index.ts",
    "test": "deno test --allow-net --allow-env"
  },
  "imports": {
    "@std/": "https://deno.land/std@0.224.0/"
  }
}