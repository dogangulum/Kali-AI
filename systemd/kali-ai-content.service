# Günlük içerik worker'ı (tek seferlik çalışır, timer tetikler)
# Konum: /etc/systemd/system/kali-ai-content.service

[Unit]
Description=Kali AI daily content run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/kali-ai
EnvironmentFile=/opt/kali-ai/.env.local
ExecStart=/usr/bin/node worker/index.cjs
StandardOutput=append:/var/log/kali-ai/content-out.log
StandardError=append:/var/log/kali-ai/content-error.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Playwright's Chromium lives under /root/.cache unless PLAYWRIGHT_BROWSERS_PATH is set
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/lib/kali-ai/ms-playwright
ReadWritePaths=/var/log/kali-ai /opt/kali-ai /var/lib/kali-ai
