# Her gün 07:30 (sunucu saati Europe/Istanbul) + değişiklik talepleri için saatte bir.
# Etkinleştirme: sudo systemctl enable --now kali-ai-content.timer

[Unit]
Description=Kali AI daily content run timer

[Timer]
OnCalendar=*-*-* 07:30:00
OnCalendar=*-*-* 08..22:05:00
Persistent=true

[Install]
WantedBy=timers.target
