# Systemd Servis Dosyası: WhatsApp Webhook
# Konum: /etc/systemd/system/kali-ai-whatsapp.service
# Etkinleştirme: sudo systemctl enable --now kali-ai-whatsapp

[Unit]
Description=Kali AI WhatsApp Webhook (Deno)
Documentation=https://github.com/<KULLANICI>/<REPO>
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/kali-ai
Environment=DENO_DIR=/root/.deno/cache
EnvironmentFile=/opt/kali-ai/.env.local
ExecStart=/root/.deno/bin/deno run --allow-net --allow-env=META_WHATSAPP_VERIFY_TOKEN,META_APP_SECRET supabase/functions/whatsapp-webhook/index.ts
Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3
StandardOutput=append:/var/log/kali-ai/whatsapp-out.log
StandardError=append:/var/log/kali-ai/whatsapp-error.log
SyslogIdentifier=kali-ai-whatsapp

# Güvenlik
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/kali-ai /opt/kali-ai

[Install]
WantedBy=multi-user.target